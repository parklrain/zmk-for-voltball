#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo1 {
            bindings = <&kp LPAR>;
            key-positions = <2 3>;
        };

        combo2 {
            bindings = <&kp RPAR>;
            key-positions = <6 7>;
        };

        combo7 {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <4 5>;
        };

        combo8 {
            bindings = <&kp PIPE>;
            key-positions = <14 15>;
        };

        combo9 {
            bindings = <&kp ENTER>;
            key-positions = <18 19>;
        };

        combo10 {
            bindings = <&mo 5>;
            key-positions = <11 12>;
        };

        combo_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <29 17>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <18 30>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_mclk {
            bindings = <&mkp MCLK>;
            key-positions = <8 18>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_prev {
            bindings = <&mkp MB4>;
            key-positions = <16 28>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_next {
            bindings = <&mkp MB5>;
            key-positions = <15 27>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <300>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        hmr: homerow_right_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 14 24 0 1 3 10 11 12 13 21 22 23 20 35 36 37 38 39>;
        };

        hml: homerow_left_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 27 28 29 30 31 35 36 37 38 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp W            &kp E         &kp R         &kp T                                    &kp Y             &kp U         &kp I         &kp O        &kp P
&hml LEFT_GUI A  &hml LEFT_ALT S  &hml LSHFT D  &hml LCTRL F  &kp G                                    &kp H             &hmr LCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RIGHT_GUI SEMICOLON
&kp Z            &kp X            &kp C         &kp V         &kp B        &mo 5          &kp B        &kp N             &kp M         &lt 5 COMMA   &lt 5 DOT    &lt 5 SLASH
&kp LCTRL        &kp LGUI         &kp LALT      &lt 1 ESC     &lt 2 SPACE  &lt 3 TAB      &lt 1 ENTER  &ltq 2 BACKSPACE                              &kp RALT     &kp RCTRL
            >;

            display-name = "BASE";
        };

        NUM {
            bindings = <
&kp TAB    &kp N7  &kp N8  &kp N9   &kp MINUS                      &kp HOME         &kp END   &kp N8    &kp N9     &kp N0
&kp ASTRK  &kp N4  &kp N5  &kp N6   &kp PLUS                       &kp PG_UP        &kp LEFT  &kp UP    &kp RIGHT  &kp SQT
&trans     &kp N1  &kp N2  &kp N3   &kp COMMA  &trans      &trans  &kp PAGE_DOWN    &kp LBKT  &kp DOWN  &kp RBKT   &trans
&trans     &trans  &trans  &kp DOT  &kp N0     &trans      &trans  &kp RIGHT_SHIFT                      &trans     &trans
            >;

            display-name = "NUM";
        };

        layer_2 {
            bindings = <
&kp ESC     &trans  &trans  &trans  &trans                      &trans  &kp HOME  &kp UP_ARROW  &kp END    &bootloader
&kp CAPS    &trans  &trans  &trans  &trans                      &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans
&kp DELETE  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans        &trans     &trans
&trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans     &trans
            >;

            display-name = "SYM";
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                         &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans                         &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans    &trans    &trans    &trans     &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans    &trans    &trans    &kp LCTRL  &trans      &trans  &trans                      &trans    &trans
            >;

            display-name = "MOUSE";
        };

        BT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans  &trans  &trans  &trans  &trans                      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                    &trans        &trans
            >;

            display-name = "BT";
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                  &trans  &trans
            >;
        };
    };
};
