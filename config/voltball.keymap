#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <300>;
    quick-tap-ms = <180>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_lpar {
            bindings = <&kp LPAR>;
            key-positions = <2 3>;
        };

        combo_rpar {
            bindings = <&kp RPAR>;
            key-positions = <6 7>;
        };

        combo_mclk {
            bindings = <&mkp MCLK>;
            key-positions = <29 30>;
        };

        combo_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <29 17>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <18 30>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_bspc {
            bindings = <&kp BSPC>;
            key-positions = <9 19>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_prev {
            bindings = <&mkp MB4>;
            key-positions = <16 28>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_next {
            bindings = <&mkp MB5>;
            key-positions = <15 27>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            slow-release;
        };

        combo_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <20 10>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_cut {
            bindings = <&kp LC(X)>;
            key-positions = <21 11>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_copy {
            bindings = <&kp LC(C)>;
            key-positions = <22 12>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_paste {
            bindings = <&kp LC(V)>;
            key-positions = <23 13>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <19 31>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_sym {
            bindings = <&mo 2>;
            key-positions = <38 39>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_hanja {
            bindings = <&kp RCTRL>;
            key-positions = <17 19>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
        };

        combo_lang {
            bindings = <&kp RALT>;
            key-positions = <16 18>;
            timeout-ms = <50>;
            require-prior-idle-ms = <60>;
            layers = <0>;
        };

        combo_lbkt {
            bindings = <&kp LBKT>;
            key-positions = <3 4>;
        };

        combo_rbkt {
            bindings = <&kp RBKT>;
            key-positions = <6 5>;
        };
    };

    behaviors {
        hmr: homerow_right_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 14 24 0 1 3 10 11 12 13 21 22 23 20 35 36 37 38 39>;
        };

        hml: homerow_left_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 27 28 29 30 31 35 36 37 38 39>;
        };

        sk_shft: sk_shft {
            compatible = "zmk,behavior-sticky-key";
            label = "SK_SHFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        magic_shft_tap: magic_shft_tap {
            compatible = "zmk,behavior-mod-morph";
            label = "MAGIC_SHFT_TAP";
            bindings = <&sk_shft LSHFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        magic_shft: magic_shft {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_SHFT";
            bindings = <&kp>, <&magic_shft_tap>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W        &kp E         &kp R         &kp T                                               &kp Y         &kp U         &kp I         &kp O        &kp P
&hml LWIN A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G                                               &kp H         &hmr LCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RWIN SEMI
&kp Z        &kp X        &kp C         &kp V         &kp B        &mo 5             &lt 3 B              &kp N         &kp M         &ltq 5 COMMA  &ltq 5 DOT   &ltq 5 SLASH
&kp LCTRL    &kp LGUI     &kp LALT      &ltq 3 TAB    &ltq 1 BSPC  &ltq 2 ENTER      &magic_shft LSHFT 0  &ltq 1 SPACE                              &kp LALT     &kp LCTRL
            >;

            display-name = "BASE";
        };

        num_layer {
            bindings = <
&kp GRAVE       &trans          &kp UP           &kp BSPC          &kp DEL                              &kp MINUS  &kp N7         &kp N8         &kp N9        &kp ASTRK
&hml LWIN RALT  &hml LALT LEFT  &hml LSHFT DOWN  &hml LCTRL RIGHT  &kp PG_UP                            &kp PLUS   &hmr LCTRL N4  &hmr RSHFT N5  &hmr LALT N6  &hmr RWIN SQT
&kp RCTRL       &trans          &kp HOME         &kp END           &kp PG_DN  &kp SPACE      &kp EQUAL  &kp COMMA  &kp N1         &kp N2         &kp N3        &trans
&trans          &trans          &trans           &trans            &kp N0     &trans         &kp DOT    &kp N0                                   &trans        &trans
            >;

            display-name = "NUM";
        };

        sym_layer {
            bindings = <
&kp TILDE     &kp C_PREV      &kp UP          &kp C_NEXT       &kp C_PLAY_PAUSE                          &kp UNDER  &kp AMPS  &kp ASTRK  &kp BSPC   &kp DEL
&kp CAPS      &kp LEFT        &kp DOWN        &kp RIGHT        &kp C_VOL_UP                              &kp BSLH   &kp DLLR  &kp PRCNT  &kp CARET  &kp DQT
&msc SCRL_UP  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &kp C_VOL_DN      &kp K_MUTE      &trans  &kp PIPE   &kp EXCL  &kp AT     &kp HASH   &trans
&trans        &trans          &trans          &trans           &trans            &trans          &trans  &trans                          &trans     &trans
            >;

            display-name = "SYM";
        };

        fnc_layer {
            bindings = <
&kp ESC          &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp INS                               &kp LC(Y)  &kp F7         &kp F8         &kp F9        &kp F12
&hml LWIN LC(A)  &hml LALT LC(S)  &trans          &trans           &trans                                &kp HOME   &hmr LCTRL F4  &hmr RSHFT F5  &hmr LALT F6  &hmr RWIN F11
&kp LC(Z)        &kp LC(X)        &kp LC(C)       &kp LC(V)        &kp LC(B)  &kp LC(LS(Z))      &trans  &kp END    &kp F1         &kp F2         &kp F3        &kp F10
&trans           &trans           &trans          &trans           &trans     &trans             &trans  &trans                                   &trans        &trans
            >;

            display-name = "FNC";
        };

        sys_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                      &bt BT_CLR  &bt BT_CLR_ALL  &out OUT_BLE  &out OUT_USB  &out OUT_TOG
&trans        &trans        &trans        &trans        &trans                            &trans      &trans          &trans        &trans        &trans
&sys_reset    &trans        &trans        &trans        &trans        &trans      &trans  &trans      &trans          &trans        &trans        &sys_reset
&bootloader   &trans        &trans        &trans        &trans        &trans      &trans  &trans                                    &trans        &bootloader
            >;

            display-name = "SYS";
        };

        scr_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                  &trans  &trans
            >;

            label = "SCR";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        SYS_LAYER {
            if-layers = <1 3>;
            then-layer = <4>;
        };
    };
};
